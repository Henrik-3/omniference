{
  "model": "openai/gpt-4o",
  "input": "Give me facts about Lisbon as JSON.",
  "text": {
    "format": {
      "type": "json_schema",
      "name": "city_info",
      "strict": true,
      "schema": {
        "type": "object",
        "properties": {
          "city": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "population_millions": {
            "type": "number"
          }
        },
        "required": [
          "city",
          "country",
          "population_millions"
        ],
        "additionalProperties": false
      }
    }
  },
  "stream": true
}
