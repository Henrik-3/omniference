{
  "requests": [
    {
      "body": {
        "input": "Give me basic facts about Madrid.",
        "model": "gpt-6-luna",
        "stream": false,
        "text": {
          "format": {
            "name": "city_info",
            "schema": {
              "additionalProperties": false,
              "properties": {
                "city": {
                  "type": "string"
                },
                "country": {
                  "type": "string"
                },
                "population": {
                  "type": "integer"
                }
              },
              "required": [
                "city",
                "country",
                "population"
              ],
              "type": "object"
            },
            "strict": true,
            "type": "json_schema"
          }
        }
      },
      "headers": {
        "accept": "*/*",
        "authorization": "[REDACTED]",
        "content-type": "application/json"
      },
      "method": "POST",
      "uri": "/v1/responses"
    }
  ]
}
