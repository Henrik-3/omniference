{
	"model": "glm-5.3-flash",
	"input": "Fix the typo 'teh' in README.md.",
	"tools": [
		{
			"type": "custom",
			"name": "apply_patch",
			"description": "Edit files with a patch.",
			"format": {
				"type": "grammar",
				"syntax": "lark",
				"definition": "start: /(.|\n)+/"
			}
		},
		{
			"type": "namespace",
			"name": "shell_tools",
			"description": "Shell helpers",
			"tools": [
				{
					"type": "function",
					"name": "exec",
					"description": "Run a shell command",
					"parameters": {
						"type": "object",
						"properties": {
							"command": {
								"type": "string"
							}
						},
						"required": [
							"command"
						],
						"additionalProperties": false
					}
				}
			]
		}
	],
	"stream": false
}
