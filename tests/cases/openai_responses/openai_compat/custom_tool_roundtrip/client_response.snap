input_file: tests/cases/openai_responses/openai_compat/custom_tool_roundtrip/client_request.json
---
{
  "body": {
    "background": false,
    "billing": {
      "payer": "openai"
    },
    "created_at": "[timestamp]",
    "id": "[uuid]",
    "metadata": {},
    "model": "case/glm-5.3-flash",
    "object": "response",
    "output": [
      {
        "content": [
          {
            "annotations": [],
            "logprobs": [],
            "text": "Fixed the typo; the directory holds README.md and src.",
            "type": "output_text"
          }
        ],
        "id": "msg_[hex]",
        "role": "assistant",
        "status": "completed",
        "type": "message"
      }
    ],
    "parallel_tool_calls": true,
    "reasoning": {},
    "service_tier": "default",
    "status": "completed",
    "store": true,
    "temperature": 1.0,
    "text": {
      "format": {
        "type": "text"
      },
      "verbosity": "medium"
    },
    "tool_choice": "auto",
    "tools": [
      {
        "description": "Edit files with a patch.",
        "format": {
          "definition": "start: /(.|\n)+/",
          "syntax": "lark",
          "type": "grammar"
        },
        "name": "apply_patch",
        "type": "custom"
      },
      {
        "description": "Shell helpers\n\nRun a shell command",
        "name": "shell_tools__exec",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "command": {
              "type": "string"
            }
          },
          "required": [
            "command"
          ],
          "type": "object"
        },
        "type": "function"
      }
    ],
    "top_logprobs": 0,
    "top_p": 1.0,
    "truncation": "disabled",
    "usage": {
      "input_tokens": 120,
      "input_tokens_details": {
        "cached_tokens": 0
      },
      "output_tokens": 30,
      "output_tokens_details": {
        "reasoning_tokens": 0
      },
      "total_tokens": 150
    }
  },
  "content_type": "application/json",
  "status": 200
}
