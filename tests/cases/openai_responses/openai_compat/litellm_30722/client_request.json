{
	"model": "glm-5.3-flash",
	"input": "List the files in the current directory.",
	"tools": [
		{
			"type": "namespace",
			"name": "shell_tools",
			"description": "Shell helpers",
			"tools": [
				{
					"type": "function",
					"name": "exec",
					"description": "Run a shell command",
					"parameters": {
						"type": "object",
						"properties": {
							"command": {
								"type": "string"
							}
						},
						"required": [
							"command"
						],
						"additionalProperties": false
					},
					"strict": true
				}
			]
		},
		{
			"type": "function",
			"name": "get_weather",
			"description": "Get the current weather for a city",
			"parameters": {
				"type": "object",
				"properties": {
					"city": {
						"type": "string"
					}
				},
				"required": [
					"city"
				],
				"additionalProperties": false
			},
			"strict": true
		}
	],
	"tool_choice": "auto",
	"stream": true
}
