---
source: tests/unit/case_matrix.rs
description: openai_chat/openai_responses/json_schema
input_file: tests/cases/openai_chat/openai_responses/json_schema/client_request.json
---
{
  "requests": [
    {
      "body": {
        "input": [
          {
            "content": [
              {
                "text": "Give me basic facts about Madrid.",
                "type": "input_text"
              }
            ],
            "role": "user",
            "type": "message"
          }
        ],
        "model": "gpt-4o-mini",
        "stream": false,
        "temperature": 1.0,
        "text": {
          "format": {
            "name": "city_info",
            "schema": {
              "additionalProperties": false,
              "properties": {
                "city": {
                  "type": "string"
                },
                "country": {
                  "type": "string"
                },
                "population": {
                  "type": "integer"
                }
              },
              "required": [
                "city",
                "country",
                "population"
              ],
              "type": "object"
            },
            "strict": true,
            "type": "json_schema"
          }
        },
        "tool_choice": "auto",
        "top_p": 1.0
      },
      "headers": {
        "accept": "*/*",
        "authorization": "[REDACTED]",
        "content-type": "application/json"
      },
      "method": "POST",
      "uri": "/v1/responses"
    }
  ]
}
