---
{
  "requests": [
    {
      "body": {
        "generation_config": {
          "temperature": 1.0,
          "top_p": 1.0
        },
        "input": [
          {
            "content": [
              {
                "text": "Extract: Alice Smith, 34, alice@example.com",
                "type": "text"
              }
            ],
            "type": "user_input"
          }
        ],
        "model": "gemini-2.5-flash",
        "response_format": {
          "mime_type": "application/json",
          "schema": {
            "additionalProperties": false,
            "properties": {
              "age": {
                "type": "integer"
              },
              "email": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "age",
              "email"
            ],
            "type": "object"
          },
          "type": "text"
        },
        "store": false,
        "stream": false
      },
      "headers": {
        "accept": "*/*",
        "content-type": "application/json",
        "x-goog-api-key": "[REDACTED]"
      },
      "method": "POST",
      "uri": "/v1/interactions"
    }
  ]
