---
source: tests/unit/case_matrix.rs
description: openai_chat/openrouter/json_schema
input_file: tests/cases/openai_chat/openrouter/json_schema/client_request.json
---
{
  "requests": [
    {
      "body": {
        "input": [
          {
            "content": [
              {
                "text": "Give me facts about Lisbon as JSON.",
                "type": "input_text"
              }
            ],
            "role": "user",
            "type": "message"
          }
        ],
        "model": "z-ai/glm-5.3-flash",
        "stream": false,
        "text": {
          "format": {
            "name": "city_info",
            "schema": {
              "additionalProperties": false,
              "properties": {
                "city": {
                  "type": "string"
                },
                "country": {
                  "type": "string"
                },
                "population_millions": {
                  "type": "number"
                }
              },
              "required": [
                "city",
                "country",
                "population_millions"
              ],
              "type": "object"
            },
            "strict": true,
            "type": "json_schema"
          }
        }
      },
      "headers": {
        "accept": "*/*",
        "authorization": "[REDACTED]",
        "content-type": "application/json"
      },
      "method": "POST",
      "uri": "/v1/responses"
    }
  ]
}
