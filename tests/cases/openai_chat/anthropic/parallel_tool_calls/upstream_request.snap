---
source: tests/unit/case_matrix.rs
description: openai_chat/anthropic/parallel_tool_calls
input_file: tests/cases/openai_chat/anthropic/parallel_tool_calls/client_request.json
---
{
  "requests": [
    {
      "body": {
        "cache_control": {
          "type": "ephemeral"
        },
        "max_tokens": 512,
        "messages": [
          {
            "content": "What is the weather and the local time in Tokyo?",
            "role": "user"
          }
        ],
        "model": "claude-sonnet-4-5",
        "stream": false,
        "temperature": 1.0,
        "tools": [
          {
            "description": "Get the current weather for a city",
            "input_schema": {
              "properties": {
                "city": {
                  "type": "string"
                }
              },
              "required": [
                "city"
              ],
              "type": "object"
            },
            "name": "get_weather"
          },
          {
            "description": "Get the current local time for a city",
            "input_schema": {
              "properties": {
                "city": {
                  "type": "string"
                }
              },
              "required": [
                "city"
              ],
              "type": "object"
            },
            "name": "get_time"
          }
        ],
        "top_p": 1.0
      },
      "headers": {
        "accept": "*/*",
        "anthropic-version": "2023-06-01",
        "content-type": "application/json",
        "x-api-key": "[REDACTED]"
      },
      "method": "POST",
      "uri": "/v1/messages"
    }
  ]
}
