---
source: tests/unit/case_matrix.rs
description: openai_chat/anthropic/json_schema
input_file: tests/cases/openai_chat/anthropic/json_schema/client_request.json
---
{
  "requests": [
    {
      "body": {
        "cache_control": {
          "type": "ephemeral"
        },
        "max_tokens": 256,
        "messages": [
          {
            "content": "Extract the person: Ada Lovelace died at age 36.",
            "role": "user"
          }
        ],
        "model": "claude-haiku-5-5",
        "output_config": {
          "format": {
            "schema": {
              "additionalProperties": false,
              "properties": {
                "age": {
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "age"
              ],
              "type": "object"
            },
            "type": "json_schema"
          }
        },
        "stream": false
      },
      "headers": {
        "accept": "*/*",
        "anthropic-version": "2023-06-01",
        "content-type": "application/json",
        "x-api-key": "[REDACTED]"
      },
      "method": "POST",
      "uri": "/v1/messages"
    }
  ]
}
